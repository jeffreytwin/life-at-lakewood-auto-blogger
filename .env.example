# Supabase (client-safe, prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase (server-only, used in /api/ routes)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Anthropic (server-only)
ANTHROPIC_API_KEY=sk-ant-...

# SEMrush Analytics API (server-only) — real keyword volume/difficulty/CPC.
# Find your key at https://www.semrush.com/api-documentation/
SEMRUSH_API_KEY=...

# Wix (server-only)
WIX_API_KEY=...

# Google OAuth (server-only)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Optional: stable OAuth redirect (recommended)
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/google/auth
# Fallback if Supabase token storage is unavailable
GOOGLE_REFRESH_TOKEN=...
